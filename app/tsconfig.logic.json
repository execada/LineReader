{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/entities/document/record.ts",
    "src/entities/language",
    "src/entities/line/*.ts",
    "src/features/ask-server/client.ts",
    "src/features/dictionary/dictionary.ts",
    "src/features/export/pdf.ts",
    "src/features/export/text.ts",
    "src/features/recognize/page.ts",
    "src/features/search",
    "src/shared/lib",
    "src/widgets/document-card/summary.ts",
    "src/**/*.test.ts",
    "scripts",
    "src/entities/document/queue.ts",
    "src/entities/document/text.ts"
  ]
}
