{
  "name": "sverka-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "eval:review": "node scripts/eval-review.ts",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . && knip",
    "fetch:tessdata": "sh scripts/fetch-tessdata.sh",
    "typecheck:logic": "tsc --noEmit -p tsconfig.logic.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-plugin-react-native": "5.0.0",
    "knip": "6.39.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@expo-google-fonts/golos-text": "0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "0.4.1",
    "@pdf-lib/fontkit": "1.1.1",
    "expo": "57.0.28",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-document-scanner-plugin": "2.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "zod": "4.6.7"
  },
  "main": "index.ts"
}
